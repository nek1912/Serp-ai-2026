# Dev ports. Vite reads these; they must match the Clerk URLs below.
VITE_PORT=5180
BFF_PORT=8787

# ── Browser-safe (exposed to the bundle via VITE_ prefix) ──────────────
# Rename of NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Rename of NEXT_PUBLIC_CLERK_SIGN_IN_URL. No longer set in the Vercel
# dashboard — passed to <ClerkProvider signInUrl> instead.
VITE_CLERK_SIGN_IN_URL=http://localhost:5180/sign-in
# Rename of NEXT_PUBLIC_CLERK_SIGN_UP_URL.
VITE_CLERK_SIGN_UP_URL=http://localhost:5180/sign-up

# ── Server-only (read only by server/, never bundled) ──────────
# @clerk/express reads THIS name at runtime. It does not understand the
# VITE_ prefix. The BFF refuses to boot without a publishable key.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Was MISSING from both .env.example files in the Next.js project despite
# all 11 route handlers requiring it.
BACKEND_API_URL=http://localhost:8010
