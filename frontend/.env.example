# Azure Translator — for runtime on-demand website translation.
# Copy this file to .env.local and fill in real values from your Azure resource.
# (Azure Portal -> your Translator resource -> "Keys and Endpoint")

# Secret — never commit a real value (use .env.local, which is git-ignored).
AZURE_TRANSLATOR_KEY=your-azure-translator-subscription-key

# Region shown on your resource (e.g. southcentralus, eastasia). Use "global" if not region-bound.
AZURE_TRANSLATOR_REGION=southcentralus

# Endpoint from "Keys and Endpoint" (no trailing slash; usually https://api.cognitive.microsofttranslator.com)
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# ──────────────────────────────────────────────
# Clerk Authentication — https://dashboard.clerk.com
# Create a free Clerk project and paste the values below.
# ──────────────────────────────────────────────

# Publishable key (safe for client-side — starts with pk_test_ or pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret key (server-side only — starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Sign-in / sign-up page routes (must match pages in src/app/)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
