# Backend configuration — copy to .env and fill in real values.
# Backend reads ONLY backend/.env (absolute path); a repo-root .env is ignored.
# Never commit real keys. Placeholders below mirror backend/.env key-for-key.

GROQ_API_KEY=gsk_replace_me
GEMINI_API_KEY=AIza_replace_me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_KEY=eyJ_replace_me
JINA_API_KEY=jina_replace_me
JINA_API_KEY_2=jina_replace_me
AZURE_TRANSLATOR_KEY=replace_me
AZURE_TRANSLATOR_REGION=eastasia
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_SPEECH_KEY=replace_me
AZURE_SPEECH_REGION=eastasia
AZURE_SPEECH_ENDPOINT=https://eastasia.api.cognitive.microsoft.com/
SARVAM_API_KEY=sk_replace_me
SARVAM_API_KEY_2=sk_replace_me
GROQ_API_KEY_1=gsk_replace_me
GROQ_API_KEY_2=gsk_replace_me
TAVILY_API_KEY_1=tvly-dev-replace_me
TAVILY_API_KEY_2=tvly-dev-replace_me
FIRECRAWL_API_KEY=fc-replace_me
SEARCH_PROVIDERS=tavily,serpapi
SERPAPI_API_KEY_1=replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
CLERK_ISSUER=https://your-clerk-app.clerk.accounts.dev

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SELECTED_STATE=gujarat
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSION=768
RERANKER_PROVIDER=gemini
RERANKER_TOP_N=6
RERANKER_MODEL=jina-reranker-v2-base-multilingual
VECTOR_DB=supabase
# LLM - Use actual Groq models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Tokens - Reduce for speed
DEFAULT_MAX_TOKENS=800
STREAMING_ENABLED=true
# Caching
EMBEDDING_CACHE_SIZE=1000
VECTOR_CACHE_TTL=3600
# Reranker wired but OFF (frozen: Recall@1 drops 0.85->0.50 when on)
RERANKER_ENABLED=false
CITATION_REPAIR_ENABLED=true
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_MODEL=gemini-3.5-flash
# Relevance thresholds
MIN_RELEVANCE_SCORE=40.0
MIN_TRUST_SCORE=35.0
# BM25 and RRF settings
BM25_TOP_K=15
RRF_K=60
# Timeouts
REQUEST_TIMEOUT_S=15
LLM_TIMEOUT_S=12
WEB_RAG_TIMEOUT_S=45
# Default State
DEFAULT_STATE=gujarat
