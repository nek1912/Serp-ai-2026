GROQ_API_KEY=
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CORS. Must list the origin the frontend is served from. The React app runs on
# Vite (:5173 by default); it used to be Next.js on :3000.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clerk. The browser sends its Clerk session token straight to this API, and
# app/auth.py verifies it against this issuer's JWKS.
#
# CRITICAL: this MUST be the same Clerk application the frontend signs in with
# (the instance behind frontend/.env's VITE_CLERK_PUBLISHABLE_KEY). If they
# differ, every authenticated request returns 401 while the app appears to
# work — chat, grievance and TTS all fail with no obvious cause.
# Derive it from the frontend's publishable key:
#   base64-decode the part after pk_test_ -> "<instance>.clerk.accounts.dev"
CLERK_ISSUER=
CLERK_SECRET_KEY=

SELECTED_STATE=gujarat
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-2
# Phase 4/5: Reranker (disabled until curated eval proves value)
JINA_API_KEY=
RERANKER_ENABLED=false
RERANKER_MODEL=jina-reranker-v2-base-multilingual
RETRIEVAL_STRATEGY=dense

# Web Search Providers
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1
SERPAPI_API_KEY_1=
SERPAPI_API_KEY_2=
SEARCH_PROVIDERS=tavily,firecrawl

# Evidence & Grievance
GRIEVANCE_GEMINI_MODEL=gemini-3.5-flash-lite
