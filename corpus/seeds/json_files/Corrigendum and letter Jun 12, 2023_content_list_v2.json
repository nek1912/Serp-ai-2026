                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The undersigned is directed to refer to the subject mentioned above and to say that the guidelines for the Centrally Sponsored Project for Computerization of PACS were circulated to all the States/Union Territories (UTs) vide this Ministry's communication dated 2/1/2023/"
                    }
