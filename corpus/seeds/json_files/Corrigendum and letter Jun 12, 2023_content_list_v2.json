            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "4. It is therefore, requested to kindly ensure that the revised clauses as per corrigendum dated 12.06.2023 are followed for implementation of the Computerization of PACS project along with other guidelines."
                    }
                ]
            },
