            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2. As decided in the 3rd meeting of the National Level Monitoring and Implementation Committee (NLMIC) held on 6th June, 2023 under the chairmanship of Secretary (M/o Cooperation), the corrigendum to the clauses of the Project Guidelines, are enclosed herewith."
                    }
                ]
